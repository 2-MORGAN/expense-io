  end

  pg[("PostgreSQL 16<br/>port 5433<br/>RLS · outbox_events")]
  s3[("S3 : LocalStack<br/>port 4567<br/>bucket receipts")]
  ocr["Moteur OCR jetable<br/>sharp + tesseract.js<br/>processus enfant du worker,<br/>et du web pour l'inspection<br/>et la route synchrone"]
  smtp["SMTP : Mailpit<br/>1025 · interface 8025"]
  mailbox(["Boîte mail<br/>liens d'invitation<br/>et de vérification"])
  ops["Scripts npm<br/>migrate:up · seed<br/>ensure-bucket<br/>réconciliation, nettoyage"]
  cron["Tâche planifiée quotidienne<br/>ops/cron : réconciliation<br/>des reçus orphelins"]
