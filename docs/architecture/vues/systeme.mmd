  user -->|"pages, formulaires"| pages
  user -->|"fetch JSON, multipart"| api
  pages --> core
  api --> core
  core -->|"expense_app, withUserScope :<br/>SQL, RLS, outbox"| pg
  core -->|"reçus"| s3
  user ~~~ loops
  user ~~~ cleanup
  user ~~~ stats
  stats -->|"pending, dead, âge"| pg
  loops -->|"expense_worker :<br/>prise en charge"| pg
  loops --> handlers
  handlers -->|"emails"| smtp
  handlers -->|"analyse détachée"| ocr
  handlers -->|"reçus"| s3
  cleanup -->|"reçus analysés"| s3
  smtp --> mailbox
  user -.->|"reçu par URL pré-signée"| s3
  user -.->|"pages vues, 3 événements, si UMAMI_WEBSITE_ID est défini ;<br/>heatmap et replays sans texte de 3 pages si UMAMI_HEATMAP=true"| umami
  user ~~~ ops
  ops --> pg
  ops --> s3
  cron -->|"expense_worker"| ops

