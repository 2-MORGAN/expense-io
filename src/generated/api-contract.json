  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "authjs.session-token",
        "description": "Cookie Auth.js ; préfixe __Secure- en HTTPS selon sa configuration."
      }
    },
    "requestBodies": {
      "Receipt": {
        "required": true,
        "content": {
          "multipart/form-data": {
            "schema": {
              "$ref": "#/components/schemas/ReceiptInput"
            }
          }
        }
      }
    },
    "responses": {
      "Problem": {
        "description": "Refus explicite ou erreur interne, sans fuite technique",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Unavailable": {
        "description": "OCR_UNAVAILABLE, OCR_TIMEOUT ou OCR_OVERLOADED",
        "headers": {
          "Retry-After": {
            "required": true,
            "schema": {
              "type": "string",
              "const": "5"
            }
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "AuthenticationRequired": {
        "description": "Authentication required.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/LegacyError"
            }
          },
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "InternalError": {
        "description": "Internal server error.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/LegacyError"
            }
          },
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "InvalidInput": {
        "description": "Invalid input; no write or upload.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "ResourceNotFound": {
        "description": "Resource not found or not visible; indistinguishable response.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/LegacyError"
            }
          },
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Role is not allowed.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/LegacyError"
            }
          },
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Conflict": {
        "description": "Resource conflict: ALREADY_DECIDED or INVALID_MANAGER.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/LegacyError"
            }
          },
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "ReceiptSuggestion": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "expenseDate": {
            "$ref": "#/components/schemas/CivilDate"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "description": "Nom du commerçant lu en tête du reçu, proposé comme description (ajout compatible, 1.1.0)."
          }
        },
        "examples": [
          {
            "amount": 42.5,
            "expenseDate": "2026-10-11",
            "description": "Restaurant le Test"
          },
          {}
        ]
      },
      "AnalysisAccepted": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed"
            ]
          }
        }
      },
      "ReceiptAnalysis": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed"
            ]
          },
          "result": {
            "$ref": "#/components/schemas/ReceiptSuggestion"
          },
          "error": {
            "$ref": "#/components/schemas/Problem"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "succeeded"
                }
              }
            },
            "then": {
              "required": [
                "result"
              ],
              "properties": {
                "result": {
                  "$ref": "#/components/schemas/ReceiptSuggestion"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "failed"
                }
              }
            },
            "then": {
              "required": [
                "error"
              ],
              "properties": {
                "error": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        ]
      },
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code",
          "requestId"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri-reference"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "enum": [
              "VALIDATION_ERROR",
              "RECEIPT_TOO_LARGE",
              "RECEIPT_TYPE_NOT_ALLOWED",
              "IMAGE_TOO_LARGE",
              "OCR_UNAVAILABLE",
              "OCR_TIMEOUT",
              "OCR_OVERLOADED",
              "AUTHENTICATION_REQUIRED",
              "RESOURCE_NOT_FOUND",
              "INVALID_IDEMPOTENCY_KEY",
              "IDEMPOTENCY_KEY_REUSED",
              "INTERNAL_ERROR",
              "INVALID_JSON",
              "FORBIDDEN",
              "ALREADY_DECIDED",
              "INVALID_MANAGER"
            ]
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "error": {
            "type": "string",
            "deprecated": true
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "field",
                "code",
                "message"
              ],
              "properties": {
                "field": {
                  "type": "string"
                },
                "code": {
                  "type": "string",
                  "enum": [
                    "REQUIRED",
                    "INVALID_UUID",
                    "INVALID_AMOUNT",
                    "INVALID_DATE",
                    "INVALID_TYPE",
                    "UNKNOWN_FIELD",
                    "DUPLICATE_FIELD",
                    "EMPTY_FILE"
                  ]
                },
                "message": {
                  "type": "string",
                  "description": "Public English message; never includes the submitted value."
                }
              }
            }
          }
        },
        "examples": [
          {
            "type": "/problems/validation-error",
            "title": "Validation failed",
            "status": 400,
            "detail": "The request does not satisfy the API contract.",
            "code": "VALIDATION_ERROR",
            "requestId": "00000000-0000-4000-8000-000000000001",
            "error": "Champs invalides",
            "errors": [
              {
                "field": "amount",
                "code": "INVALID_AMOUNT",
                "message": "The field does not satisfy the API contract."
              }
            ]
          }
        ]
      },
      "LegacyError": {
        "type": "object",
        "deprecated": true,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "description": "Enveloppe historique transitoire ; supprimée après migration 2-485. Aucun détail interne ne fait partie du contrat public."
      },
      "Uuid": {
        "type": "string",
        "format": "uuid"
      },
      "ExpenseNote": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "userId",
          "amount",
          "expenseDate",
          "description",
          "receiptKey",
          "status",
          "createdAt"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Uuid"
          },
          "userId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 99999999.99,
            "multipleOf": 0.01
          },
          "expenseDate": {
            "$ref": "#/components/schemas/CivilDate"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "receiptKey": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        },
        "examples": [
          {
            "id": "00000000-0000-4000-8000-000000000001",
            "userId": "00000000-0000-4000-8000-000000000002",
            "amount": 12.5,
            "expenseDate": "2024-02-29",
            "description": "Repas client",
            "receiptKey": "receipts/1.pdf",
            "status": "pending",
            "createdAt": "2026-10-23T12:00:00.000Z"
          }
        ]
      },
      "CompanyUser": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "email",
          "role",
          "managerId"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": [
              "employee",
              "manager"
            ]
          },
          "managerId": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Uuid"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "examples": [
          {
            "id": "00000000-0000-4000-8000-000000000001",
            "name": "Marie Manager",
            "email": "marie@example.org",
            "role": "manager",
            "managerId": null
          }
        ]
      },
      "ReceiptUrl": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "URL S3 présignée, valable au plus 300 secondes."
          }
        }
      },
      "Receipt": {
        "type": "string",
        "format": "binary",
        "description": "Fichier non vide, 10 Mio maximum. Création : PNG/JPEG/WebP/PDF, type et structure vérifiés. OCR : PDF valide → résultat vide ; images analysées limitées à 40 Mpx et réduites à 2500 px. Un type non analysable reste une suggestion vide après contrôle de présence et taille.",
        "x-maxBytes": 10485760,
        "x-multipartOverheadBytes": 65536,
        "x-mediaTypes": [
          "image/png",
          "image/jpeg",
          "image/webp",
          "application/pdf"
        ],
        "x-ocrMaxPixels": 40000000,
        "x-ocrMaxSide": 2500
      },
      "CreateExpenseNote": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "amount",
          "expenseDate",
          "description",
          "receipt"
        ],
        "properties": {
          "amount": {
            "type": "string",
            "pattern": "^[0-9]{1,8}(?:\\.[0-9]{1,2})?$",
            "not": {
              "pattern": "^0+(?:\\.0{1,2})?$"
            },
            "description": "Décimal complet > 0, point comme séparateur, au plus 2 décimales, maximum 99999999.99. Sans arrondi ni conversion permissive.",
            "examples": [
              "12",
              "12.5",
              "12.50"
            ]
          },
          "expenseDate": {
            "$ref": "#/components/schemas/CivilDate"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "receipt": {
            "$ref": "#/components/schemas/Receipt"
          }
        }
      },
      "ReceiptInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "receipt"
        ],
        "properties": {
          "receipt": {
            "$ref": "#/components/schemas/Receipt"
          }
        }
      },
      "SetManager": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "managerId"
        ],
        "properties": {
          "managerId": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Uuid"
              },
              {
                "type": "null"
              }
            ],
            "description": "null détache explicitement ; absent, JSON malformé ou mauvais type donne 400 sans écriture. UUID bien formé mais manager non admissible : 409."
          }
        },
        "examples": [
          {
            "managerId": "00000000-0000-4000-8000-000000000001"
          },
          {
            "managerId": null
          }
        ]
      },
      "CreateInvitation": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "description": "Adresse du salarié invité, sans espaces autour ; mise en minuscules par le serveur."
          }
        },
        "examples": [
          {
            "email": "salarie@example.org"
          }
        ]
      },
      "InvalidEmailError": {
        "type": "object",
        "deprecated": true,
        "additionalProperties": false,
        "required": [
          "error",
          "code"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "const": "INVALID_EMAIL"
          }
        },
        "description": "Enveloppe historique de l’invitation, comme LegacyError avec un code stable ; remplacée par application/problem+json avec 2-485.",
        "examples": [
          {
            "error": "Invalid email",
            "code": "INVALID_EMAIL"
          }
        ]
      },
      "Invitation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "email",
          "expiresAt"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "Fin de validité du lien, 7 jours après la dernière invitation."
          }
        },
        "examples": [
          {
            "id": "00000000-0000-4000-8000-000000000001",
            "email": "salarie@example.org",
            "expiresAt": "2026-11-02T10:00:00.000Z"
          }
        ]
      },
      "CivilDate": {
        "type": "string",
        "format": "date",
        "pattern": "^(?!0000)\\d{4}-\\d{2}-\\d{2}$",
        "description": "Date civile réelle du calendrier grégorien, année 0001 à 9999 (PostgreSQL n’accepte pas l’année zéro), sans fuseau ni interdiction des dates futures.",
        "examples": [
          "2024-02-29",
          "2026-10-23"
        ]
      }
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "Même origine que le frontend"
    }
  ],
  "tags": [
    {
      "name": "OCR",
      "description": "Suggestion synchrone et analyses asynchrones."
    },
    {
      "name": "Expenses and organisation",
      "description": "Notes, décisions et organisation de l’entreprise."
    }
  ]
}
