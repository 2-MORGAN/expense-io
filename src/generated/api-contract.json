{
  "openapi": "3.1.0",
  "info": {
    "title": "Expense.io API",
    "version": "1.0.0",
    "description": "Contrat HTTP des 17 opérations métier (Auth.js exclu). ADR-004 : URL stables, pas de pagination. Les refus historiques application/json restent transitoirement disponibles jusqu’à 2-485 ; les nouvelles validations et le module OCR utilisent application/problem+json. Les permissions documentées ne dispensent pas des contrôles de sécurité ADR-001."
  },
  "security": [
    {
      "session": []
    }
  ],
  "paths": {
    "/api/expense-notes/receipt-suggestion": {
      "post": {
        "operationId": "suggestReceiptFields",
        "summary": "Analyse synchrone conservée pour compatibilité",
        "requestBody": {
          "$ref": "#/components/requestBodies/Receipt"
        },
        "responses": {
          "200": {
            "description": "Suggestion, éventuellement vide (PDF ou aucun champ reconnu)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReceiptSuggestion"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "500": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "tags": [
          "OCR"
        ]
      }
    },
    "/api/receipt-analyses": {
      "post": {
        "operationId": "launchReceiptAnalysis",
        "summary": "Enregistre durablement une analyse, avant de répondre 202",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Rejeu identique pendant 24 h ; autre contenu avec la même clé donne 422."
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/Receipt"
        },
        "responses": {
          "202": {
            "description": "Analyse acceptée, ou rejeu d'une analyse existante",
            "headers": {
              "Location": {
                "required": true,
                "schema": {
                  "type": "string"
                },
                "description": "URL relative de suivi"
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisAccepted"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          },
          "500": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "tags": [
          "OCR"
        ]
      }
    },
    "/api/receipt-analyses/{id}": {
      "get": {
        "operationId": "getReceiptAnalysis",
        "summary": "Consulte sa propre analyse, conservée pendant 24 h",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "État courant ; une analyse failed reste un GET réussi",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReceiptAnalysis"
                }
              }
            }
          },
          "400": {
            "description": "Malformed UUID.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "description": "Analyse inconnue, étrangère ou expirée.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "tags": [
          "OCR"
        ]
      }
    },
    "/api/expense-notes": {
      "get": {
        "operationId": "listExpenseNotes",
        "summary": "Toutes les notes de l’utilisateur connecté, sans pagination.",
        "description": "Session required. Session and role are checked before structural validation; malformed input is rejected before writes/uploads.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ExpenseNote"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "parameters": [
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Tri historique. Tris légitimes : created_at, amount, expense_date, description, status, avec ASC/DESC. Défaut created_at DESC. La sécurisation par liste blanche est portée par 2-471 ; aucune expression SQL arbitraire ne constitue un usage garanti."
          }
        ],
        "tags": [
          "Expenses and organisation"
        ]
      },
      "post": {
        "operationId": "createExpenseNote",
        "summary": "Crée une note avec son reçu pour l’utilisateur connecté.",
        "description": "Session required. Session and role are checked before structural validation; malformed input is rejected before writes/uploads. The receipt is stored first, then the note is written in one transaction.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Renvoi identique (même montant, date, description et reçu) pour le même utilisateur ; renvoie la note déjà créée, sans doublon. Autre contenu avec la même clé donne 422. Sans en-tête, aucune déduplication."
          }
        ],
        "responses": {
          "201": {
            "description": "Note created, or replay of the note already created for this Idempotency-Key",
            "headers": {
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "const": "true"
                },
                "description": "Présent uniquement lors d’un rejeu ; aucun reçu ni note n’a été créé."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExpenseNote"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidInput"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/CreateExpenseNote"
              }
            }
          }
        },
        "tags": [
          "Expenses and organisation"
        ]
      }
    },
    "/api/expense-notes/{id}/receipt-url": {
      "get": {
        "operationId": "getOwnReceiptUrl",
        "summary": "Reçu d’une note appartenant à l’utilisateur.",
