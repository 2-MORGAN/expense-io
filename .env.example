# PostgreSQL (docker-compose). Un rôle par usage (ADR-001, 2-481) :
# - DATABASE_URL : l'application, rôle restreint soumis à la RLS ;
# - WORKER_DATABASE_URL : le worker de l'outbox et la réconciliation des reçus ;
# - MIGRATION_DATABASE_URL : le propriétaire des tables, pour les migrations,
#   le seed et le nettoyage ponctuel ;
# - E2E_DATABASE_URL : préparation des données des tests E2E (propriétaire).
# `npm run migrate:up` pose sur les deux rôles restreints les mots de passe
# écrits ici, et `make env` les remplace par des valeurs aléatoires en créant
# .env. Valeurs de développement local uniquement.
DATABASE_URL=postgres://expense_app:expense-app-local@localhost:5433/expense_io
WORKER_DATABASE_URL=postgres://expense_worker:expense-worker-local@localhost:5433/expense_io
MIGRATION_DATABASE_URL=postgres://expense:expense@localhost:5433/expense_io
E2E_DATABASE_URL=postgres://expense:expense@localhost:5433/expense_io

# Auth.js
# Generate with: npx auth secret
AUTH_SECRET=changeme-generate-a-real-secret-for-non-local-use
# Requis uniquement en production (`next start`/`npm run start`).
# AUTH_TRUST_HOST=true

# Stockage objet S3-compatible (LocalStack en local, docker-compose)
S3_ENDPOINT=http://localhost:4567
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_BUCKET=receipts
S3_FORCE_PATH_STYLE=true

# Emails (Mailpit en local, docker-compose) : interface sur http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Expense.io <no-reply@expense.io>"
# Obligatoire en production (le worker refuse de démarrer sans SMTP_HOST).
# Fournisseur en production : SMTP_HOST, SMTP_PORT=465, SMTP_SECURE=true, SMTP_USER, SMTP_PASSWORD
# Adresse publique de l'application, pour les liens d'invitation et de
# vérification d'email (obligatoire en production)
APP_URL=http://localhost:3000

# Intervalle d'interrogation de l'outbox par le worker, en millisecondes (2000 par défaut)
# WORKER_POLL_INTERVAL_MS=2000
