{
  "name": "expense-io-version-b",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run check:api",
    "prepare": "husky",
    "migrate:up": "node-pg-migrate up --envPath .env -d MIGRATION_DATABASE_URL --ignore-pattern \"[^0-9].*\" && node scripts/provision-db-roles.mjs",
    "migrate:down": "node-pg-migrate down --envPath .env -d MIGRATION_DATABASE_URL --ignore-pattern \"[^0-9].*\"",
    "ensure-bucket": "node scripts/ensure-bucket.mjs",
    "seed": "node scripts/seed.mjs",
    "reconcile:orphan-receipts": "node scripts/reconcile-orphan-receipts.mjs",
    "clean:notes-without-receipt": "node scripts/clean-notes-without-receipt.mjs",
    "worker": "tsx src/worker/main.ts",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e:coverage": "node scripts/coverage/e2e.mjs",
    "test:coverage:ui": "vitest --ui --coverage.enabled",
    "test:e2e": "playwright test",
    "generate:api": "openapi-typescript openapi.yaml -o src/types/api.d.ts && node scripts/generate-api.mjs",
    "check:api": "redocly lint openapi.yaml && openapi-typescript openapi.yaml -o src/types/api.d.ts --check && node scripts/generate-api.mjs --check && node scripts/check-api.mjs",
    "generate:architecture": "tsx scripts/architecture/generate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/context-async-hooks": "2.12.0",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.223.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/instrumentation": "0.223.0",
    "@opentelemetry/instrumentation-pg": "0.75.0",
    "@opentelemetry/instrumentation-runtime-node": "0.36.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace": "2.12.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "next": "16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "10.0.16",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@redocly/cli": "^2.71.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.13.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "c8": "^12.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-plugin-sonarjs": "^4.2.2",
    "husky": "^9.1.7",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "nodemailer": "$nodemailer"
  }
}
