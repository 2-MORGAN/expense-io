    "/api/hr/invitations": {
      "post": {
        "operationId": "inviteEmployee",
        "summary": "RH : inviter un salarié à rejoindre son entreprise (S7, ADR-001 §3).",
        "description": "Session required, hr_admin only. The invitation belongs to the caller's company, read in the database. An address is trimmed and lower-cased before use. Inviting an address that already has a pending invitation in the same company returns that invitation with a new expiry and invalidates the previous link. The email itself is sent asynchronously through the outbox.",
        "responses": {
          "201": {
            "description": "Invitation created or renewed; email queued.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Invitation"
                }
              }
            }
          },
          "400": {
            "description": "Missing or malformed email address; nothing written. Historical envelope until 2-485.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvalidEmailError"
                }
              }
            }
          },
          "401": {
