    playwrightDb["Playwright sans navigateur<br/>RLS, outbox, scripts<br/>(job e2e)"]
  end

  subgraph unitaire["Unitaire : une règle pure, sans entrée-sortie · Vitest, à côté du code · npm run check"]
    direction LR
    domain["Domaine<br/>règles métier"]
